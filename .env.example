# Clerk Publishable Key – sicher für das Frontend (beginnt mit pk_test_ oder pk_live_)
# Erstelle einen Account auf https://clerk.com → New Application → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# API URL des Backends (leer lassen = selber Origin / Vite-Proxy)
VITE_API_URL=

# Optional: Sentry-DSN für Error-Tracking im Frontend. Leer lassen = kein
# Sentry-Aufruf, keine Account-Pflicht. DSN erhält man unter sentry.io →
# Project Settings → Client Keys (DSN).
VITE_SENTRY_DSN=
