# PostgreSQL – wird von Railway automatisch gesetzt wenn du das Postgres-Plugin hinzufügst
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Clerk – aus dem Clerk-Dashboard unter "API Keys" (beginnt mit sk_live_ oder sk_test_)
# WICHTIG: Niemals in den Frontend-Code oder Git committen
CLERK_SECRET_KEY=sk_live_...

# URL des Frontends (für CORS) – deine Vercel-URL
FRONTEND_URL=https://deine-app.vercel.app

# Optional: Port (Railway setzt PORT automatisch)
# PORT=3001
