DATABASE_URL=postgresql://ck_user:ck_password@localhost:5432/compliancekit
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Anthropic API Key – NUR im Backend, niemals im Frontend!
# Docs: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Clerk Secret Key – NUR im Backend, niemals im Frontend!
# Clerk Dashboard → API Keys → Secret Key (beginnt mit sk_test_ oder sk_live_)
CLERK_SECRET_KEY=sk_test_...

# Optional: Sentry-DSN für Error-Tracking im Backend. Leer lassen = kein
# Sentry-Aufruf, keine Account-Pflicht.
SENTRY_DSN=
